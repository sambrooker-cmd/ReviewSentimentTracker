# Copy to .env for local runs (npm run import / npm run check-stale).
# In GitHub Actions these come from repo secrets instead — see SETUP.md.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Only needed locally if you want alert-filing to work outside Actions —
# a personal access token with `issues: write` on this repo.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
